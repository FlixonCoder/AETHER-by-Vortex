# ============================================================
#  SatOps AI — Environment Configuration
#  Copy this file to .env and fill in your credentials.
#  NEVER commit .env to version control.
# ============================================================

# ---- Option A: Anthropic API (Claude models) ----
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# ---- Option B: OpenRouter (routes to any model) ----
# ANTHROPIC_API_KEY=sk-or-v1-your-key-here
# LLM_PROVIDER=openrouter

# ---- Option C: NVIDIA NIM API ----
# ANTHROPIC_API_KEY=nvapi-your-key-here
# LLM_PROVIDER=openrouter
# OPENROUTER_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENROUTER_MONITOR_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# OPENROUTER_REASONING_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# LLM_REASONING_EFFORT=none

# ---- Offline / Demo Mode ----
# Set to 1 to run fully offline with mock LLM (no API key needed)
# SATOPS_OFFLINE=1

# ---- Server ----
# PORT=8000
