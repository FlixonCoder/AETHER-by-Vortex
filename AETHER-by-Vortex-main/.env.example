# ============================================================
#  AETHER / SatOps AI — Environment Configuration
#  Copy this file to .env and fill in your credentials.
#  NEVER commit real API keys to version control.
# ============================================================

# ---- Tier 1: Local Ollama (Primary Mode) ----
# Defaults to local Ollama running Qwen 0.5B
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2:0.5b
OLLAMA_TIMEOUT=15.0

# ---- Tier 2: Cloud Groq (Cloud Fallback) ----
# Used if Ollama is offline or times out.
# Get a free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT=20.0

# ---- Tier 3: Deterministic Rule Engine (Always-On Safety Fallback) ----
FORCE_RULE_ENGINE=0

# ---- Rolling Telemetry Analysis & Statistical Filter ----
# Maximum historical context window (operates immediately from first samples)
ROLLING_WINDOW_SECONDS=60.0
ROLLING_MIN_SAMPLES=2
SPIKE_ZSCORE_THRESHOLD=2.5
PERSISTENCE_TICKS_THRESHOLD=3
CRITICAL_ZSCORE_THRESHOLD=4.5
EMERGENCY_DEVIATION_RATIO=0.35

# ---- Server Configuration ----
PORT=8000
